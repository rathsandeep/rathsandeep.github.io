---
layout: default
---
<div class="post home-layout">
  <div class="row">
    <aside class="col-md-3 profile-sidebar">
      {% include profile_sidebar.liquid %}
    </aside>

    <div class="col-md-9 home-main">
  <article>
    <h1 class="post-title home-title">about me</h1>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Impact in practice -->
    {% if page.impact %}
      <h2>Collaborating organizations</h2>
      <p class="collaborate-note">{{ page.impact }}</p>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/research/' | relative_url }}" style="color: inherit">Recent publications</a>
      </h2>
      {% include selected_papers.liquid %}
      <p class="more-link"><a href="{{ '/research/' | relative_url }}">All research &rarr;</a></p>
    {% endif %}

        <!-- Working papers -->
    {% if page.working_papers %}
      <h2>
        <a href="{{ '/research/' | relative_url }}" style="color: inherit">Working papers</a>
      </h2>
      {% include working_papers.liquid %}
    {% endif %}

            <!-- In Progress papers -->
    {% if page.inprogress_papers %}
      <h2>
        <a href="{{ '/research/' | relative_url }}" style="color: inherit">Work in progress</a>
      </h2>
      {% include inprogress_papers.liquid %}
    {% endif %}

    <!-- Talks -->
    {% if page.talks %}
      <h2>
        <a href="{{ '/talks/' | relative_url }}" style="color: inherit">Talks and events</a>
      </h2>
      {% include talks_home.liquid limit=3 %}
      <p class="more-link"><a href="{{ '/talks/' | relative_url }}">All talks &rarr;</a></p>
    {% endif %}

    <!-- Media -->
    {% if page.media %}
      <h2>
        <a href="{{ '/media/' | relative_url }}" style="color: inherit">In the media</a>
      </h2>
      {% include media.liquid limit=3 %}
      <p class="more-link"><a href="{{ '/media/' | relative_url }}">All media &rarr;</a></p>
    {% endif %}

    <!-- Working with me -->
    {% if page.collaborate %}
      <h2>Working with me</h2>
      <p class="collaborate-note">{{ page.collaborate }}</p>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
      </div>
    {% endif %}
  </article>
    </div>
  </div>
</div>
