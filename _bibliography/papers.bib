@article{celik2023does,
  abstract={Using about 150,000 appointments from 74 physicians, we study how the timing of EHR work affects physician workload. EHR work done before an appointment reduces both total EHR time and after-hours work, while work done after an appointment reduces after-hours work but increases total EHR time.},
  preview={ehr_timing.png},
  title={Frontiers in Operations: Does Physician's Choice of When to Perform EHR Tasks Influence Total EHR Workload?},
