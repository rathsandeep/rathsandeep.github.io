{% comment %} Inline PDF viewer. Param: file (site path to the PDF). {% endcomment %}
{% assign pdf_url = include.file | relative_url %}
<p class="pdf-actions">
  <a href="{{ pdf_url }}" download><i class="fa-solid fa-download"></i> Download PDF</a>
  <span class="sep">&middot;</span>
  <a href="{{ pdf_url }}" target="_blank" rel="noopener"><i class="fa-solid fa-up-right-from-square"></i> Open in new tab</a>
</p>
<div class="pdf-container" data-pdf="{{ pdf_url }}">
  <p class="pdf-loading">Loading&hellip;</p>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
  (function () {
    var container = document.querySelector(".pdf-container");
    var url = container.getAttribute("data-pdf");
    var pdfDoc = null;
    var lastWidth = 0;

    function fallback() {
      container.innerHTML =
        '<iframe src="' + url + '" title="PDF" class="pdf-fallback"></iframe>';
    }

    function render() {
      var width = container.clientWidth;
      if (!pdfDoc || Math.abs(width - lastWidth) < 20) return;
      lastWidth = width;
      container.innerHTML = "";
      var ratio = window.devicePixelRatio || 1;
      var chain = Promise.resolve();
      for (var n = 1; n <= pdfDoc.numPages; n++) {
        (function (num) {
          chain = chain.then(function () {
            return pdfDoc.getPage(num).then(function (page) {
              var base = page.getViewport({ scale: 1 });
              var viewport = page.getViewport({ scale: (width / base.width) * ratio });
              var canvas = document.createElement("canvas");
              canvas.className = "pdf-page";
              canvas.width = viewport.width;
              canvas.height = viewport.height;
              canvas.style.width = width + "px";
              container.appendChild(canvas);
              return page.render({ canvasContext: canvas.getContext("2d"), viewport: viewport }).promise;
            });
          });
        })(n);
      }
    }

    if (!window.pdfjsLib) { fallback(); return; }
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    pdfjsLib.getDocument(url).promise.then(function (doc) {
      pdfDoc = doc;
      render();
      var timer;
      window.addEventListener("resize", function () {
        clearTimeout(timer);
        timer = setTimeout(render, 250);
      });
    }).catch(fallback);
  })();
</script>
