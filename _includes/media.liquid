<ul class="media-list">
  {% for item in site.data.media %}
    {% if include.limit and forloop.index > include.limit %}{% break %}{% endif %}
    <li>
      <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>, <em>{{ item.outlet }}</em>, {{ item.year }}
    </li>
  {% endfor %}
</ul>
